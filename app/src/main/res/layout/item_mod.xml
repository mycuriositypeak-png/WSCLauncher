<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:background="@drawable/icon_tile" android:src="@drawable/ic_extension" android:importantForAccessibility="no" app:tint="?attr/colorOnPrimaryContainer" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/mod_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                <TextView android:id="@+id/mod_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/mod_switch" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" />
            <ImageButton android:id="@+id/mod_more" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/details" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more_vert" app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <TextView android:id="@+id/mod_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:maxLines="3" android:ellipsize="end" android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/mod_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="0dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
